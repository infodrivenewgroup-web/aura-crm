--
-- Data for Name: schema_migrations; Type: TABLE DATA; Schema: supabase_migrations; Owner: postgres
--

COPY supabase_migrations.schema_migrations (version, statements, name, created_by, idempotency_key, rollback) FROM stdin;
20260712000834	{"\n-- ---------------------------------------------------------------------------\n-- Safe auto-cleanup of old, finalized orders on Site C (the FINAL store).\n--\n-- Site C never re-syncs onward; the only safe \\"deletable\\" signal is that an\n-- order is in a TERMINAL status, is older than a retention window, AND has had\n-- no activity for a quiet window. This migration adds:\n--   1) maintenance_state: a single-row table holding the last cleanup time so\n--      the job runs at most once per day (opportunistic + cron both honour it).\n--   2) cleanup_old_orders(): deletes ONE bounded batch of qualifying orders\n--      (and their sync_events audit rows) so we never hold a long table lock or\n--      compete with incoming sync writes.\n-- Nothing here changes the orders schema, the sync endpoints, or their format.\n-- ---------------------------------------------------------------------------\n\ncreate table if not exists public.maintenance_state (\n  id int primary key default 1,\n  last_cleanup_at timestamptz,\n  constraint maintenance_state_singleton check (id = 1)\n);\n\ninsert into public.maintenance_state (id, last_cleanup_at)\nvalues (1, null)\non conflict (id) do nothing;\n\n-- One bounded cleanup batch. Returns the number of ORDER rows deleted.\n-- Safety contract enforced entirely inside this parameterized query:\n--   * created_at_source is known AND older than p_retention_cutoff\n--   * status is TERMINAL (caller passes the exact raw list from unifyStatus)\n--   * GREATEST of every lifecycle timestamp is older than p_quiet_cutoff\n-- FOR UPDATE SKIP LOCKED gives incoming sync writes absolute priority: any row\n-- currently being upserted is simply skipped this round (picked up next time).\ncreate or replace function public.cleanup_old_orders(\n  p_retention_cutoff timestamptz,\n  p_quiet_cutoff timestamptz,\n  p_terminal_statuses text[],\n  p_batch_size int\n)\nreturns integer\nlanguage plpgsql\nsecurity definer\nset search_path = public\nas $$\ndeclare\n  v_deleted integer;\nbegin\n  with victims as (\n    select id, source_site, source_order_id\n    from public.aggregated_orders\n    where created_at_source is not null\n      and created_at_source < p_retention_cutoff\n      and lower(status) = any (p_terminal_statuses)\n      and greatest(\n            received_at,\n            coalesce(updated_at_source, 'epoch'::timestamptz),\n            coalesce(paid_at,          'epoch'::timestamptz),\n            coalesce(canceled_at,      'epoch'::timestamptz),\n            coalesce(chargebacked_at,  'epoch'::timestamptz),\n            coalesce(expired_at,       'epoch'::timestamptz),\n            coalesce(refunded_at,      'epoch'::timestamptz),\n            coalesce(last_callback_at, 'epoch'::timestamptz),\n            coalesce(created_at_source,'epoch'::timestamptz)\n          ) < p_quiet_cutoff\n    order by created_at_source asc\n    limit greatest(p_batch_size, 1)\n    for update skip locked\n  ),\n  del_events as (\n    delete from public.sync_events se\n    using victims v\n    where se.source_site = v.source_site\n      and se.source_order_id = v.source_order_id\n    returning se.id\n  ),\n  del_orders as (\n    delete from public.aggregated_orders o\n    using victims v\n    where o.id = v.id\n    returning o.id\n  )\n  select count(*) into v_deleted from del_orders;\n  return coalesce(v_deleted, 0);\nend;\n$$;\n"}	add_orders_autocleanup	tild1111@proton.me	\N	\N
20260801005444	{"create index if not exists aggregated_orders_created_at_source_idx on public.aggregated_orders (created_at_source desc); create index if not exists aggregated_orders_paid_at_idx on public.aggregated_orders (paid_at desc) where paid_at is not null;"}	hardening_orders_indexes	tild1111@proton.me	\N	\N
20260801005529	{"create index if not exists aggregated_orders_created_source_received_idx on public.aggregated_orders (created_at_source desc nulls last, received_at desc); drop index if exists aggregated_orders_created_at_source_idx;"}	hardening_orders_composite_sort_index	tild1111@proton.me	\N	\N
\.


